{
  "schema_version": 1,
  "protocol_id": "stage7-verified-deer-crossing-v1",
  "description": "One identical first-attempt request per API model for the only animal capability that passed the grounded local probe.",
  "scene_config": "configs/stage7_scene_editing.json",
  "request_limits": {
    "repeat_count": 1,
    "retry_count": 0,
    "timeout_s": 60.0,
    "max_output_tokens": 256,
    "maximum_total_requests": 3
  },
  "models": [
    {
      "variant_id": "openai_gpt_6_astra",
      "provider": "openai_responses",
      "api_key_env": "OPENAI_API_KEY",
      "base_url_env": "OPENAI_BASE_URL",
      "default_base_url": "https://api.openai.com/v1",
      "model_env": "OPENAI_MODEL",
      "default_model": "gpt-6-astra"
    },
    {
      "variant_id": "dashscope_qwen_27b",
      "provider": "dashscope_chat_completions",
      "api_key_env": "DASHSCOPE_API_KEY",
      "base_url_env": "DASHSCOPE_BASE_URL",
      "default_base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
      "model_env": "QWEN_27B_MODEL",
      "default_model": "qwen3.8-27b"
    },
    {
      "variant_id": "dashscope_qwen_8b",
      "provider": "dashscope_chat_completions",
      "api_key_env": "DASHSCOPE_API_KEY",
      "base_url_env": "DASHSCOPE_BASE_URL",
      "default_base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
      "model_env": "QWEN_8B_MODEL",
      "default_model": "qwen3-8b"
    }
  ],
  "task": {
    "task_id": "verified_deer_lateral_crossing",
    "user_request": "On Town01_Opt route_01_straight in clear_day, create the verified deer crossing. Use the fixed route-relative anchor at 32 m, move laterally from +6 m to -6 m at 2 m/s, and start at simulation time 0 s. Use any valid integer seed.",
    "expected_scene_without_seed": {
      "version": "1.1",
      "map_name": "Town01_Opt",
      "route_id": "route_01_straight",
      "weather_id": "clear_day",
      "animal": {
        "type": "deer",
        "anchor": {
          "route_progress_m": 32.0
        },
        "trajectory": {
          "kind": "lateral_crossing",
          "start_lateral_offset_m": 6.0,
          "end_lateral_offset_m": -6.0
        },
        "speed_mps": 2.0,
        "start_time_s": 0.0
      }
    }
  }
}
