# TEMPLATE ONLY. Copy to .env privately on the VM when implementing stage 0.
# These names are read by the stage-0 scripts where relevant.
# Never commit .env or paste real keys into the chat or report.

CARLA_HOST=127.0.0.1
CARLA_PORT=2000
CARLA_TM_PORT=8000

# Stage 6 API credentials and inventory-selected endpoints/model IDs.
# Keep real values only in untracked .env; never use placeholders in source code.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-astra

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_27B_MODEL=qwen3.8-27b
QWEN_8B_MODEL=qwen3-8b

# Choose real storage locations in stage 0. Do not insert signed URLs here.
TASK_RUNS_DIR=runs
TASK_EXTERNAL_STORAGE=
